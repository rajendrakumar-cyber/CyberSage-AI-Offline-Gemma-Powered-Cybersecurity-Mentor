{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and authentication data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "description": "Display name" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "AnalysisHistory": {
      "title": "Analysis History",
      "description": "Historical security analysis sessions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "hasFile": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "prompt", "response", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Private user profiles"
    },
    "history/{historyId}": {
      "schema": "AnalysisHistory",
      "description": "Analysis logs restricted by user ID"
    }
  }
}
